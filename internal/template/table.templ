package template

import "fmt"

templ DependencyTable(params dependencyTable){
    <table>
        <thead>
            <tr>
                <th class="activity-column">
                    Activity
                </th>
                <th class="dependency-column">
                    Dependencies
                </th>
                <th class="duration-column">
                    Duration
                </th>
                <th class="action-column">
                </th>
            </tr>
        </thead>
        @DependencyTableBody(params.dependencyTableBody)
    </table>
}

templ DependencyTableBody(params dependencyTableBody){
    <tbody id={fmt.Sprintf("activity-table-body-%s", params.ProjectId)} { params.hxAttr... }>
        for _, row := range params.Rows{
            @DependencyTableRow(row)
        }
    </tbody>
}

templ DependencyTableRow(params dependencyTableRow){
    <tr class={params.Class} id={params.Id} {params.hxAttr...}>
           <!-- activity name -->
        <td>
            @TextInput(params.ActivityTextInputParams)
        </td>
        
        <!-- Dependencies -->
        <td>
            <div
                class={params.DependencyWrapperDivParams.Class}
                id={params.DependencyWrapperDivParams.Id}
            >
                @TextInput(params.DependencyTextInputParams)
                @DivWrapChildren(params.DependencySuggestionDivParams)
            </div>
        </td>
        
        <!-- Duration -->
        <td>
            @TextInput(params.DurationTextInputParams)
        </td>
        
        <!-- Add row -->
        <td>
            <div class="actions">
                @Button(params.TableRowAddBtnParams)
            </div>
        </td>
    </tr>
}

templ DependencyTableRowDependencyFieldDropdown(divParams *htmxDiv, btnParams *htmxButton){
    @DivWrapChildren(divParams){
        @Button(btnParams)
    }
}

templ TemplateDependencyTableBody(params dependencyTableBody){
    @TemplateWrapChildren(){
        @DependencyTableBody(params)
    }
}