package view

templ home(table *table) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1.0">
			<title>Task Planner</title>
			<link rel="stylesheet" href="/static/home_style.css"/>
		</head>
		<body>
			<div class="container">
				<h1>Task Planner</h1>
				<div class="table-wrapper">
					@displayDependencyTable(table)
				</div>
			</div>
			<script>

				/*
				* Add a new task row.
				*/
				function addTaskRow(button) {

					const currentRow = button.closest(".task-row");

					const newRow = currentRow.cloneNode(true);

					/*
					* Clear all input values.
					*/
					newRow.querySelectorAll("input").forEach(input => {
						input.value = "";
					});

					/*
					* Clear autocomplete results.
					*/
					newRow
						.querySelector(".autocomplete")
						.innerHTML = "";

					/*
					* Insert the new row immediately after
					* the row whose + button was clicked.
					*/
					currentRow.after(newRow);

					/*
					* HTMX needs to process dynamically-added
					* elements.
					*/
					htmx.process(newRow);

					/*
					* Focus the new task name.
					*/
					newRow
						.querySelector(".task-name")
						.focus();
				}


				/*
				* When the user selects an autocomplete suggestion,
				* append it to the comma-separated dependency list.
				*
				* The server should return:
				*
				* <div class="suggestion"
				*      data-task-name="Build API"
				*      onclick="selectDependency(this)">
				*     Build API
				* </div>
				*/
				function selectDependency(element) {

					const taskName =
						element.dataset.taskName ||
						element.textContent.trim();

					const input =
						element
							.closest(".dependency-wrapper")
							.querySelector(".dependency-input");

					/*
					* Get everything before the current
					* comma-separated value.
					*/
					const parts = input.value.split(",");

					/*
					* Replace the thing currently being typed.
					*/
					parts[parts.length - 1] = taskName;

					/*
					* Rebuild the dependency string.
					*/
					input.value = parts
						.map(value => value.trim())
						.filter(Boolean)
						.join(", ");

					/*
					* Hide suggestions.
					*/
					element
						.closest(".autocomplete")
						.innerHTML = "";

					/*
					* Put cursor back in the input.
					*/
					input.focus();

					input.setSelectionRange(
						input.value.length,
						input.value.length
					);
				}


				/*
				* Close autocomplete dropdowns when clicking
				* somewhere else.
				*/
				document.addEventListener("click", function(event) {

					if (
						!event.target.closest(".dependency-wrapper")
					) {
						document
							.querySelectorAll(".autocomplete")
							.forEach(function(element) {
								element.innerHTML = "";
							});
					}

				});


				/*
				* Don't allow the autocomplete dropdown to
				* disappear when clicking a suggestion.
				*/
				document.addEventListener("mousedown", function(event) {

					if (
						event.target.closest(".suggestion")
					) {
						event.preventDefault();
					}

				});

			</script>
		</body>
	</html>
}