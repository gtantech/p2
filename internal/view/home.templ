package view

templ home(table *table) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1.0">
			<title>Task Planner</title>
			<link rel="stylesheet" href="/static/home_style.css"/>
		</head>
		<body>
			<div class="container">
				<h1>Task Planner</h1>
				<div class="table-wrapper">
					@displayDependencyTable(table)
				</div>
			</div>
		</body>
	</html>
}