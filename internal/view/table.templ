package view

import "strings"
import "uuid"
import "fmt"
import "github.com/gtantech/p2/internal/models"

templ displayDependenciesToAdd(activities []models.ViewActivity, successorActivityId string){
    <ul>
        for _, item := range activities {
            <li><button type="button" value={item.Id.String()}>{item.DisplayName}</button></li>
        }
    </ul>
}

templ displayDependenciesToAddNotFound(){
    <ul>
        <li>Activity not found</li>
    </ul>
}

templ displayDependencyTable(table *models.ViewTable, projectId uuid.UUID){
    <table>
        <thead>
            <tr>
                <th class="task-column">
                    Task
                </th>
                <th class="dependency-column">
                    Dependencies
                </th>
                <th class="duration-column">
                    Duration
                </th>
                <th class="action-column">
                </th>
            </tr>
        </thead>

        <tbody id="task-table-body">
            for _, row := range table.Rows{
                <!--
                    Task row
                -->
                @displayDependencyTableRow(row, projectId)
            }
        </tbody>
    </table>
}

templ displayDependencyTableRow(row *models.ViewTableRow, projectId uuid.UUID){
    <tr class="task-row">
    <!-- Task name -->
    <td>
        <input
            type="text"
            name="activity_input"
            class="task-name"
            placeholder="Task name"
            autocomplete="off"
            value={row.Activity.DisplayName}
            hx-put={ fmt.Sprintf("/api/table/row/activity/%v/name", row.Activity.Id) }
            hx-trigger="input changed delay:200ms"
        >
    </td>
    <!-- Dependencies -->
    <td>
        @displayDependencyWrapper(row.Activity.Id, func() []string {
            names := make([]string, len(row.Dependencies))
            for i, d := range row.Dependencies{
                names[i] = d.DisplayName
            }
            return names
            }())
    </td>
    <!-- Duration -->
    <td>
        <input
            type="text"
            name="duration_input"
            placeholder="e.g. 2h"
            value={row.Activity.Duration.String()}
            hx-put={ fmt.Sprintf("/api/table/row/activity/%v/duration", row.Activity.Id) }
            hx-trigger="input changed delay:200ms"
        >
    </td>
    <!-- Add row -->
    <td>
        <div class="actions">
            <button
                type="button"
                class="add-button"
                title="Add task"
                
                hx-post={ fmt.Sprintf("/component/table/row/empty") }
                hx-vals={ marshalParamsToJsonField(toPostEmptyTableRow(row)) }
                hx-target="closest tr"
                hx-swap="afterend"
            >
                +
            </button>
        </div>
    </td>
</tr>
}

templ displayDependencySuggestionWrappedChildren(){
    <div
        id="dependency-suggestions"
        class="autocomplete"
        role="listbox"
    >
        { children... }
    </div>
}

templ displayDependencyWrapper(rowSuccessorActivityId uuid.UUID, dependencyNames []string){
    <div
        class="dependency-wrapper" 
        id={ fmt.Sprintf("dependency-wrapper-%s", rowSuccessorActivityId) }
    >
        @tableDependencyRowInput(rowSuccessorActivityId, dependencyNames)
        <!--
            Go server will return suggestions here.
        -->
        { children... }
    </div>
}

templ displayDependencyWrapperWithNewActivitySuggestion(rowSuccessorActivityId uuid.UUID, projectId uuid.UUID, dependencyNames []string, newSuggestedActivityDispName string){
    @displayDependencyWrapper(rowSuccessorActivityId, dependencyNames){
        @displayDependencySuggestionWrappedChildren(){
            <button
                class="suggestion"
                hx-post={ fmt.Sprintf("/component/table/row/activity/%s/dependency/activity", rowSuccessorActivityId) }
                hx-target={ fmt.Sprintf("#table-wrapper-%s", projectId) }
                hx-swap="innerHTML"
                hx-vals={ marshalParamsToJsonField(models.RoutesPostNewActivity{ProjectId: projectId, DisplayName: newSuggestedActivityDispName, Duration: 0}) }
            >
                { fmt.Sprintf("Create new activity: %v ...", newSuggestedActivityDispName) }
            </button>
        }
    }
}

templ tableDependencyRowInput(rowSuccessorActivityId uuid.UUID, dependencyNames []string){
    <input
        type="text"
        name="dependency_input"
        class="dependency-input"
        placeholder="Task A, Task B..."
        autocomplete="off"
        value={
            func() string {
                return strings.Join(dependencyNames, ", ")
            }()
        } 
        hx-post={ fmt.Sprintf("/component/table/row/activity/%v/dependency", rowSuccessorActivityId) }
        hx-target={ fmt.Sprintf("#dependency-wrapper-%s", rowSuccessorActivityId) }
        hx-swap="outerHTML"
        hx-trigger="input changed delay:500ms"
    >
}