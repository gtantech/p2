package view

import "strings"
import "uuid"
import "fmt"

templ displayDependenciesToAdd(activities []Activity, successorActivityId string){
    <ul>
        for _, item := range activities {
            <li><button type="button" value={item.id.String()}>{item.displayName}</button></li>
        }
    </ul>
}

templ displayDependenciesToAddNotFound(){
    <ul>
        <li>Activity not found</li>
    </ul>
}

templ displayDependencyTable(table *Table, projectId uuid.UUID){
    <table>
        <thead>
            <tr>
                <th class="task-column">
                    Task
                </th>
                <th class="dependency-column">
                    Dependencies
                </th>
                <th class="duration-column">
                    Duration
                </th>
                <th class="action-column">
                </th>
            </tr>
        </thead>

        <tbody id="task-table-body">
            for _, row := range table.rows{
                <!--
                    Task row
                -->
                @displayDependencyTableRow(row, projectId)
            }
        </tbody>
    </table>
}

templ displayDependencyTableRow(row *TableRow, projectId uuid.UUID){
    <tr class="task-row">
    <!-- Task name -->
    <td>
        <input
            type="text"
            name="activity_input"
            class="task-name"
            placeholder="Task name"
            autocomplete="off"
            value={row.activity.displayName}
            hx-post={ fmt.Sprintf("/table/row/activity/%v/name", row.activity.id) }
            hx-trigger="input changed delay:200ms"
        >
    </td>
    <!-- Dependencies -->
    <td>
        <div class="dependency-wrapper">
            <input
                type="text"
                name="dependency_input"
                class="dependency-input"
                placeholder="Task A, Task B..."
                autocomplete="off"
                value={
                    func() string {
                        values := make([]string, len(row.dependencies))
                        for i, dependency := range row.dependencies {
                            values[i] = dependency.displayName
                        }
                        return strings.Join(values, ", ")
                    }()
                } 
            >
            <!--
                Go server will return suggestions here.
            -->
            <div class="autocomplete"></div>
        </div>
    </td>
    <!-- Duration -->
    <td>
        <input
            type="text"
            name="duration[]"
            placeholder="e.g. 2h"
            value={row.activity.duration.String()}
        >
    </td>
    <!-- Add row -->
    <td>
        <div class="actions">
            <button
                type="button"
                class="add-button"
                title="Add task"
                
                hx-get={ fmt.Sprintf("/component/table/dependency/row/empty?project-id=%s", projectId.String()) }
                hx-target="closest tr"
                hx-swap="afterend"
            >
                +
            </button>
        </div>
    </td>
</tr>
}